<?xml version="1.0" encoding="utf-8"?>
<!--
    Network Security Config.

    - Cleartext HTTP is denied globally (usesCleartextTraffic is also false in
      the manifest, but this file is the authoritative source on 24+).
    - Certificate pinning is done in code via OkHttp's CertificatePinner
      (see network/CertPinProvider.kt) so pins can be flavored per build
      and updated without a resource-file change.
    - The `debug-overrides` block permits user-installed CAs *only* in debug
      builds so proxies like mitmproxy work during local dev.
-->
<network-security-config>

    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>

    <debug-overrides>
        <trust-anchors>
            <certificates src="system"/>
            <certificates src="user"/>
        </trust-anchors>
    </debug-overrides>

</network-security-config>
