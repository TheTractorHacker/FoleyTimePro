<?xml version="1.0" encoding="utf-8"?>
<!--
    Pre-Android 12 (API 30 and below) backup rules.
    Exclude the encrypted-prefs file that holds auth tokens and any Room
    databases so Google Drive backups never carry credentials off-device.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="foley_timepro_secure.xml"/>
    <exclude domain="database"   path="foley_timepro.db"/>
    <exclude domain="database"   path="foley_timepro.db-journal"/>
    <exclude domain="database"   path="foley_timepro.db-shm"/>
    <exclude domain="database"   path="foley_timepro.db-wal"/>
</full-backup-content>
