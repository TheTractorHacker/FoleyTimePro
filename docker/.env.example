# Database connection
DB_HOST=db
DB_NAME=timeclock
DB_USER=timeclock
DB_PASS=changeme_strong_password

# Optional: MariaDB root password (only needed if running the db service)
DB_ROOT_PASSWORD=changeme_root

# Timezone (PHP + MySQL)
DB_TIMEZONE=America/Chicago

# Domain (used by nginx/certbot in prod compose)
DOMAIN=timeclock.yourdomain.com
CERTBOT_EMAIL=admin@yourdomain.com
