# Company identifier — used for container names (no spaces)
COMPANY=acme

# Port this company's app listens on (use a different port per company)
APP_PORT=8080

# Database — MariaDB root password (only needed for the db container)
DB_ROOT_PASSWORD=changeme_root_strong

# Database connection
DB_NAME=timeclock_acme
DB_USER=timeclock
DB_PASS=changeme_strong_password

# Timezone
DB_TIMEZONE=America/Chicago

# Domain (production stack only)
DOMAIN=timeclock.yourdomain.com
CERTBOT_EMAIL=admin@yourdomain.com
