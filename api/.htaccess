RewriteEngine On

# Enable CORS
Header always set Access-Control-Allow-Origin "*"
Header always set Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
Header always set Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With"
Header always set Access-Control-Max-Age "3600"

# Handle OPTIONS requests for CORS preflight
RewriteCond %{REQUEST_METHOD} OPTIONS
RewriteRule ^(.*)$ $1 [R=200,L]

# API v1 routes
RewriteRule ^v1/auth/login$ v1/auth.php?action=login [L,QSA]
RewriteRule ^v1/auth/refresh$ v1/auth.php?action=refresh [L,QSA]
RewriteRule ^v1/auth/logout$ v1/auth.php?action=logout [L,QSA]
RewriteRule ^v1/auth/logout-all$ v1/auth.php?action=logout-all [L,QSA]

# Native app punch endpoints (writes to timepunches table)
RewriteRule ^v1/punch/status$     v1/punch.php?action=status     [L,QSA]
RewriteRule ^v1/punch/clockin$    v1/punch.php?action=clockin    [L,QSA]
RewriteRule ^v1/punch/lunchstart$ v1/punch.php?action=lunchstart [L,QSA]
RewriteRule ^v1/punch/lunchend$   v1/punch.php?action=lunchend   [L,QSA]
RewriteRule ^v1/punch/clockout$   v1/punch.php?action=clockout   [L,QSA]
RewriteRule ^v1/punch/history$    v1/punch.php?action=history    [L,QSA]

# Clock endpoints
RewriteRule ^v1/clock/in$ v1/clock.php?action=in [L,QSA]
RewriteRule ^v1/clock/out$ v1/clock.php?action=out [L,QSA]
RewriteRule ^v1/clock/status$ v1/clock.php?action=status [L,QSA]
RewriteRule ^v1/clock/history$ v1/clock.php?action=history [L,QSA]

# User endpoints
RewriteRule ^v1/user/profile$ v1/user.php?action=profile [L,QSA]
RewriteRule ^v1/user/update$ v1/user.php?action=update [L,QSA]

# Shifts endpoints
RewriteRule ^v1/shifts$ v1/shifts.php?action=list [L,QSA]
RewriteRule ^v1/shifts/my$ v1/shifts.php?action=my [L,QSA]

# Branding endpoints
RewriteRule ^v1/branding$ v1/branding.php [L,QSA]

# Time-off endpoints
RewriteRule ^v1/timeoff$ v1/timeoff.php?action=timeoff [L,QSA]
RewriteRule ^v1/timeoff/request$ v1/timeoff.php?action=request [L,QSA]
RewriteRule ^v1/timeoff/all$ v1/timeoff.php?action=all [L,QSA]
RewriteRule ^v1/timeoff/([0-9]+)/cancel$ v1/timeoff.php?action=cancel&id=$1 [L,QSA]
RewriteRule ^v1/timeoff/([0-9]+)/approve$ v1/timeoff.php?action=approve&id=$1 [L,QSA]
RewriteRule ^v1/timeoff/([0-9]+)/reject$ v1/timeoff.php?action=reject&id=$1 [L,QSA]

# Notification endpoints
RewriteRule ^v1/notifications/register$ v1/notifications.php?action=register [L,QSA]
RewriteRule ^v1/notifications/unregister$ v1/notifications.php?action=unregister [L,QSA]
RewriteRule ^v1/notifications/preferences$ v1/notifications.php?action=preferences [L,QSA]

# External server-to-server API (API-key authed; see /api/external/.htaccess)
#
# Explicit rules for every route that exists today, plus a generic fallback so a
# NEW file dropped under external/v1/ (or external/v1/reports/, live/, audit/,
# odata/) becomes reachable by file placement alone — no .htaccess edit required
# for the next endpoint. [L,QSA] on every explicit rule means the generic
# fallback only ever fires for a path with no rule above it; a route can still
# be given a dedicated rule (e.g. to rename a URL away from its filename)
# without conflicting with the fallback. This mirrors the nginx vhost's
# `rewrite ^/api/(.+?)/?$ /api/$1.php` — the production server for this app
# runs nginx, not Apache, so THAT rule is the one actually serving traffic;
# these rules exist for Apache/Docker deployments (see Install/, Dockerfile)
# where .htaccess is honored.
RewriteRule ^external/v1/punches$   external/v1/punches.php   [L,QSA]
RewriteRule ^external/v1/employees$ external/v1/employees.php [L,QSA]
RewriteRule ^external/v1/offices$   external/v1/offices.php   [L,QSA]
RewriteRule ^external/v1/shifts$    external/v1/shifts.php    [L,QSA]
RewriteRule ^external/v1/schedule$  external/v1/schedule.php  [L,QSA]
RewriteRule ^external/v1/timeoff$   external/v1/timeoff.php   [L,QSA]
RewriteRule ^external/v1/meta$      external/v1/meta.php      [L,QSA]

RewriteRule ^external/v1/reports/hours$          external/v1/reports/hours.php          [L,QSA]
RewriteRule ^external/v1/reports/summary$        external/v1/reports/summary.php        [L,QSA]
RewriteRule ^external/v1/reports/overtime$       external/v1/reports/overtime.php       [L,QSA]
RewriteRule ^external/v1/reports/utilization$    external/v1/reports/utilization.php    [L,QSA]
RewriteRule ^external/v1/reports/attendance$     external/v1/reports/attendance.php     [L,QSA]
RewriteRule ^external/v1/reports/timeoff$        external/v1/reports/timeoff.php        [L,QSA]
RewriteRule ^external/v1/reports/leave-balances$ external/v1/reports/leave-balances.php [L,QSA]
RewriteRule ^external/v1/reports/payroll$        external/v1/reports/payroll.php        [L,QSA]
RewriteRule ^external/v1/reports/exceptions$     external/v1/reports/exceptions.php     [L,QSA]
RewriteRule ^external/v1/reports/punctuality$    external/v1/reports/punctuality.php    [L,QSA]
RewriteRule ^external/v1/reports/trends$         external/v1/reports/trends.php         [L,QSA]
RewriteRule ^external/v1/reports/geofence$       external/v1/reports/geofence.php       [L,QSA]
RewriteRule ^external/v1/reports/auto-clockouts$ external/v1/reports/auto-clockouts.php [L,QSA]

RewriteRule ^external/v1/live/status$      external/v1/live/status.php      [L,QSA]
RewriteRule ^external/v1/live/headcount$   external/v1/live/headcount.php   [L,QSA]
RewriteRule ^external/v1/audit/punch-changes$ external/v1/audit/punch-changes.php [L,QSA]
RewriteRule ^external/v1/audit/access$     external/v1/audit/access.php     [L,QSA]

# Generic fallback: <anything>.php under external/v1/ becomes reachable at
# <anything> with no extension, as long as no explicit rule above already
# claimed it. %{REQUEST_FILENAME}.php must exist on disk — this only maps
# URLs onto real files, it never invents a route.
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^external/v1/(.+)$ external/v1/$1.php [L,QSA]

# OData v4 surface (api/lib/ODataQuery.php + api/external/odata/) is still being
# built as of this edit — its file layout (single dispatcher vs. one file per
# entity set, how `$metadata` is served) is that endpoint's own call per its
# task brief. The generic external/v1/ fallback above does not cover
# external/odata/ (different prefix), so add its rewrite rules here once that
# code lands and its file header documents the URLs it actually expects —
# guessing the shape now would risk wiring a route that doesn't match what got
# built. Until then it is reachable only via nginx's generic /api/<path> ->
# <path>.php mapping (see the vhost), which is what serves production traffic
# on this deployment anyway.
#
# openapi.yaml needs no rule: with no extension-based deny for .yaml below, a
# static GET is served directly. openapi.json is DELIBERATELY not exposed here
# — it is a generated artifact admin/api-docs.php reads off local disk
# (file_get_contents, not HTTP) for the interactive reference, and the
# FilesMatch rule a few lines down already blocks *.json for good reason
# (composer.json, package.json, etc.) — do not carve out an exception for it.

# Prevent directory listing
Options -Indexes

# Deny access to sensitive files
<FilesMatch "\.(env|json|lock)$">
    Order allow,deny
    Deny from all
</FilesMatch>
