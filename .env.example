# FoleyTimePro Environment Configuration
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── Database ──────────────────────────────────────────────
DB_HOST=localhost
DB_NAME=timeclock
DB_USER=timeclock
DB_PASS=your_secure_db_password_here
DB_TIMEZONE=America/Chicago

# ── JWT Secrets ────────────────────────────────────────────
# Generate with: openssl rand -hex 64
JWT_SECRET_KEY=change_this_to_a_random_64_char_hex_string
JWT_REFRESH_SECRET_KEY=change_this_to_a_different_random_64_char_hex_string
