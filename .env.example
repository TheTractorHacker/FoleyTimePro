# FoleyTimePro Environment Configuration
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── Database ──────────────────────────────────────────────
DB_HOST=localhost
DB_NAME=timeclock
DB_USER=timeclock
DB_PASS=your_secure_db_password_here
DB_TIMEZONE=America/Chicago

# ── JWT Secrets ────────────────────────────────────────────
# Generate with: openssl rand -hex 64
JWT_SECRET_KEY=change_this_to_a_random_64_char_hex_string
JWT_REFRESH_SECRET_KEY=change_this_to_a_different_random_64_char_hex_string

# ── External API (server-to-server) ────────────────────────
# Server-side pepper mixed into the SHA-256 hash of every API key.
# Generate once with: openssl rand -hex 32
# Rotating this value invalidates every existing API key — treat as long-lived.
API_KEY_PEPPER=change_this_to_a_random_32_char_hex_string

# Comma-separated list of proxy IPs whose X-Forwarded-For / X-Real-IP headers
# will be honored. Anything else is treated as the true client IP directly.
# Default is loopback (typical nginx-in-front-of-php-fpm setup).
TRUSTED_PROXIES=127.0.0.1,::1

# AES-256-GCM key for the API Keys admin page's "View" action, which lets an
# admin see a key's value again after creation. MUST differ from API_KEY_PEPPER
# — see migrations/015_api_key_reveal.sql for why they must stay independent.
# Generate with: openssl rand -hex 32
# Optional: leave unset and every key is created exactly as before (hash-only,
# never viewable again) — nothing else in the app depends on this value.
API_KEY_ENCRYPTION_KEY=change_this_to_a_different_random_32_char_hex_string
