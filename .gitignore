# Environment / secrets
# Glob, not just `.env` — a stray `.env.bak` from a manual edit is exactly as
# sensitive as the original and was NOT covered by the bare filename before.
.env
.env.*
!.env.example
auth/.env
*.env.local
docker/companies/*
!docker/companies/.gitkeep

# Cache & uploads (runtime-generated, not source)
cache/
uploads/

# Logs
logs/
*.log

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Claude internal
.claude/

# Misc leftovers
task-*.txt
timeclock/

# Vendor / third-party (composer install runs at build time)
vendor/

# Exception: firebase JWT is vendored manually, not via composer
vendor/firebase/

# Android app well-known (generated)
.well-known/
